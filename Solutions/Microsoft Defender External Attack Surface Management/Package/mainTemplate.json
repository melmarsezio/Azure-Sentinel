              "lastDataReceivedQuery": "EASMDomain\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
            },
            {
              "name": "EASMHost",
              "lastDataReceivedQuery": "EASMHost\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
