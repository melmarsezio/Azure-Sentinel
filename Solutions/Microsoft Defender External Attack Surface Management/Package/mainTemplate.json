            ]
          },
          "instructionSteps": [
            {
              "instructions": [
                {
                  "parameters": {
                    "type": "EASM",
                    "description": "Connect Microsoft Defender External Attack Surface Management (EASM) assets to ingest into Microsoft Sentinel Lake.",
                    "items": [
                      {
                        "label": "EASMDomain"
