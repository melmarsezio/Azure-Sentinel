{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "author": "Microsoft",
    "comments": "Solution template for Microsoft Defender External Attack Surface Management"
  },
  "parameters": {
    "location": {
      "type": "string",
      "minLength": 1,
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Not used, but needed to pass arm-ttk test `Location-Should-Not-Be-Hardcoded`.  We instead use the `workspace-location` which is derived from the LA workspace"
      }
    },
    "workspace-location": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "[concat('Region to deploy solution resources -- separate from location selection',parameters('location'))]"
      }
    },
    "workspace": {
      "defaultValue": "",
      "type": "string",
      "metadata": {
        "description": "Workspace name for Log Analytics where Microsoft Sentinel is setup"
      }
    }
  },
  "variables": {
    "_solutionName": "Microsoft Defender External Attack Surface Management",
    "_solutionVersion": "3.0.0",
    "solutionId": "azuresentinel.azure-sentinel-solution-easm",
    "_solutionId": "[variables('solutionId')]",
    "uiConfigId1": "EASM",
    "_uiConfigId1": "[variables('uiConfigId1')]",
    "dataConnectorContentId1": "EASM",
    "_dataConnectorContentId1": "[variables('dataConnectorContentId1')]",
    "dataConnectorId1": "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/dataConnectors', variables('_dataConnectorContentId1'))]",
    "_dataConnectorId1": "[variables('dataConnectorId1')]",
    "dataConnectorTemplateSpecName1": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',concat(parameters('workspace'),'-dc-',uniquestring(variables('_dataConnectorContentId1'))))]",
    "dataConnectorVersion1": "1.0.0",
    "_dataConnectorcontentProductId1": "[concat(take(variables('_solutionId'),50),'-','dc','-', uniqueString(concat(variables('_solutionId'),'-','DataConnector','-',variables('_dataConnectorContentId1'),'-', variables('dataConnectorVersion1'))))]",
    "_solutioncontentProductId": "[concat(take(variables('_solutionId'),50),'-','sl','-', uniqueString(concat(variables('_solutionId'),'-','Solution','-',variables('_solutionId'),'-', variables('_solutionVersion'))))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/contentTemplates",
      "apiVersion": "2023-04-01-preview",
      "name": "[variables('dataConnectorTemplateSpecName1')]",
      "location": "[parameters('workspace-location')]",
      "dependsOn": [
        "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/contentPackages', variables('_solutionId'))]"
      ],
      "properties": {
        "description": "Microsoft Defender External Attack Surface Management data connector with template version 3.0.0",
        "mainTemplate": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "[variables('dataConnectorVersion1')]",
          "parameters": {},
          "variables": {},
          "resources": [
            {
              "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',variables('_dataConnectorContentId1'))]",
              "apiVersion": "2021-03-01-preview",
              "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
              "location": "[parameters('workspace-location')]",
              "kind": "GenericUI",
              "properties": {
                "connectorUiConfig": {
                  "id": "[variables('_uiConfigId1')]",
                  "title": "Microsoft Defender External Attack Surface Management",
                  "publisher": "Microsoft",
                  "logo": "MicrosoftDefenderEASM.svg",
                  "descriptionMarkdown": "MDEASM data connector gives richer insights into security events by supplementing details about externally exposed assets and their attack surfaces. Data from this connector helps identify and monitor internet-facing resources, vulnerabilities, and potential security risks across your organization's external attack surface. [Learn about MDEASM.](https://learn.microsoft.com/en-us/azure/external-attack-surface-management/overview)",
                  "graphQueries": [
                    {
                      "metricName": "Total data received",
                      "legend": "EASMDomain",
                      "baseQuery": "EASMDomain"
                    },
                    {
                      "metricName": "Total data received",
                      "legend": "EASMHost",
                      "baseQuery": "EASMHost"
                    },
                    {
                      "metricName": "Total data received",
                      "legend": "EASMPage",
                      "baseQuery": "EASMPage"
                    },
                    {
                      "metricName": "Total data received",
                      "legend": "EASMSslCert",
                      "baseQuery": "EASMSslCert"
                    },
                    {
                      "metricName": "Total data received",
                      "legend": "EASMAutonomousSystem",
                      "baseQuery": "EASMAutonomousSystem"
                    },
                    {
                      "metricName": "Total data received",
                      "legend": "EASMIpBlock",
                      "baseQuery": "EASMIpBlock"
                    },
                    {
                      "metricName": "Total data received",
                      "legend": "EASMIpAddress",
                      "baseQuery": "EASMIpAddress"
                    }
                  ],
                  "sampleQueries": [
                    {
                      "description": "EASMDomain logs",
                      "lastDataReceivedQuery": "EASMDomain\n| sort by TimeGenerated"
                    },
                    {
                      "description": "EASMHost logs",
                      "lastDataReceivedQuery": "EASMHost\n| sort by TimeGenerated"
                    },
                    {
                      "description": "EASMPage logs",
                      "lastDataReceivedQuery": "EASMPage\n| sort by TimeGenerated"
                    },
                    {
                      "description": "EASMSslCert logs",
                      "lastDataReceivedQuery": "EASMSslCert\n| sort by TimeGenerated"
                    },
                    {
                      "description": "EASMAutonomousSystem logs",
                      "lastDataReceivedQuery": "EASMAutonomousSystem\n| sort by TimeGenerated"
                    },
                    {
                      "description": "EASMIpBlock logs",
                      "lastDataReceivedQuery": "EASMIpBlock\n| sort by TimeGenerated"
                    },
                    {
                      "description": "EASMIpAddress logs",
                      "lastDataReceivedQuery": "EASMIpAddress\n| sort by TimeGenerated"
                    }
                  ],
                  "dataTypes": [
                    {
                      "name": "EASMDomain",
                      "lastDataReceivedQuery": "EASMDomain\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
                    },
                    {
                      "name": "EASMHost",
                      "lastDataReceivedQuery": "EASMHost\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
                    },
                    {
                      "name": "EASMPage",
                      "lastDataReceivedQuery": "EASMPage\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
                    },
                    {
                      "name": "EASMSslCert",
                      "lastDataReceivedQuery": "EASMSslCert\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
                    },
                    {
                      "name": "EASMAutonomousSystem",
                      "lastDataReceivedQuery": "EASMAutonomousSystem\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
                    },
                    {
                      "name": "EASMIpBlock",
                      "lastDataReceivedQuery": "EASMIpBlock\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
                    },
                    {
                      "name": "EASMIpAddress",
                      "lastDataReceivedQuery": "EASMIpAddress\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
                    }
                  ],
                  "connectivityCriterias": [
                    {
                      "type": "EASM"
                    }
                  ],
                  "permissions": {
                    "tenant": [
                      "GlobalAdmin",
                      "SecurityAdmin"
                    ]
                  },
                  "availability": {
                    "isPreview": false,
                    "status": 2
                  },
                  "instructionSteps": [
                    {
                      "instructions": [
                        {
                          "parameters": {
                            "type": "EASM",
                            "description": "Connect Microsoft Defender External Attack Surface Management (EASM) assets to ingest into Microsoft Sentinel Lake.",
                            "items": [
                              {
                                "label": "EASMDomain"
                              },
                              {
                                "label": "EASMHost"
                              },
                              {
                                "label": "EASMPage"
                              },
                              {
                                "label": "EASMSslCert"
                              },
                              {
                                "label": "EASMAutonomousSystem"
                              },
                              {
                                "label": "EASMIpBlock"
                              },
                              {
                                "label": "EASMIpAddress"
                              }
                            ]
                          },
                          "type": "MSG"
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "type": "Microsoft.OperationalInsights/workspaces/providers/metadata",
              "apiVersion": "2023-04-01-preview",
              "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',concat('DataConnector-', last(split(variables('_dataConnectorId1'),'/'))))]",
              "properties": {
                "parentId": "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/dataConnectors', variables('_dataConnectorContentId1'))]",
                "contentId": "[variables('_dataConnectorContentId1')]",
                "kind": "DataConnector",
                "version": "[variables('dataConnectorVersion1')]",
                "source": {
                  "kind": "Solution",
                  "name": "Microsoft Defender External Attack Surface Management",
                  "sourceId": "[variables('_solutionId')]"
                },
                "author": {
                  "name": "Microsoft"
                },
                "support": {
                  "tier": "Microsoft",
                  "name": "Microsoft Corporation",
                  "email": "support@microsoft.com",
                  "link": "https://support.microsoft.com"
                }
              }
            }
          ]
        },
        "packageKind": "Solution",
        "packageVersion": "[variables('_solutionVersion')]",
        "packageName": "[variables('_solutionName')]",
        "packageId": "[variables('_solutionId')]",
        "contentSchemaVersion": "3.0.0",
        "contentId": "[variables('_dataConnectorContentId1')]",
        "contentKind": "DataConnector",
        "displayName": "Microsoft Defender External Attack Surface Management",
        "contentProductId": "[variables('_dataConnectorcontentProductId1')]",
        "id": "[variables('_dataConnectorcontentProductId1')]",
        "version": "[variables('dataConnectorVersion1')]"
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/metadata",
      "apiVersion": "2023-04-01-preview",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',concat('DataConnector-', last(split(variables('_dataConnectorId1'),'/'))))]",
      "dependsOn": [
        "[variables('_dataConnectorId1')]"
      ],
      "location": "[parameters('workspace-location')]",
      "properties": {
        "parentId": "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/dataConnectors', variables('_dataConnectorContentId1'))]",
